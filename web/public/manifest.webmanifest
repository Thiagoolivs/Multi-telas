{
  "name": "MultiTelas — Painel",
  "short_name": "MultiTelas",
  "description": "Crie a peça, publique e acompanhe as TVs da sua empresa.",
  "lang": "pt-BR",
  "dir": "ltr",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F7F8FA",
  "theme_color": "#F7F8FA",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icone-mascara-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icone-mascara-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Minhas telas",
      "short_name": "Telas",
      "description": "Ver o que cada TV está exibindo agora.",
      "url": "/app/?ir=screens",
      "icons": [{ "src": "/icons/icone-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Meus designs",
      "short_name": "Designs",
      "description": "Abrir o editor e as peças salvas.",
      "url": "/app/?ir=designs",
      "icons": [{ "src": "/icons/icone-192.png", "sizes": "192x192" }]
    }
  ]
}
